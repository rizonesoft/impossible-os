{"id": "win11.taskbar.bar.running", "surface": "taskbar", "kind": "state", "label": "Running", "order": 41, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "An app with a window that is not in front: a short indicator under the icon."}
{"id": "win11.taskbar.bar.active", "surface": "taskbar", "kind": "state", "label": "Active", "order": 42, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "The app whose window is in front: a longer accent indicator and a lighter tile behind the icon."}
{"id": "win11.taskbar.bar.attention-flashing", "surface": "taskbar", "kind": "state", "label": "Attention, flashing", "order": 43, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "A window asking for attention: the tile pulses in the attention colour."}
{"id": "win11.taskbar.bar.attention-steady", "surface": "taskbar", "kind": "state", "label": "Attention, steady", "order": 44, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "After the pulses the tile stays in the attention colour until the window is opened."}
{"id": "win11.taskbar.bar.progress-normal", "surface": "taskbar", "kind": "state", "label": "Progress, normal", "order": 45, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "A progress bar drawn across the bottom of the button in the accent colour."}
{"id": "win11.taskbar.bar.progress-paused", "surface": "taskbar", "kind": "state", "label": "Progress, paused", "order": 46, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "The same bar in the paused (yellow) colour."}
{"id": "win11.taskbar.bar.progress-error", "surface": "taskbar", "kind": "state", "label": "Progress, error", "order": 47, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "The same bar in the error (red) colour."}
{"id": "win11.taskbar.bar.progress-indeterminate", "surface": "taskbar", "kind": "state", "label": "Progress, indeterminate", "order": 48, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "A short segment that runs along the bottom of the button."}
{"id": "win11.taskbar.bar.badge", "surface": "taskbar", "kind": "state", "label": "Badge", "order": 49, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "A small count or glyph over the icon's bottom-right corner, set by the app."}
{"id": "win11.taskbar.bar.grouped-windows", "surface": "taskbar", "kind": "state", "label": "Grouped windows", "order": 50, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "Several windows of one app on one button; the indicator is unchanged and hover shows a row of previews."}
{"id": "win11.taskbar.bar.preview-row", "surface": "taskbar", "kind": "state", "label": "Row of previews", "order": 51, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "Hovering a button with several windows shows one preview per window side by side, each with its own title row; the row is not exposed to UI Automation on 26300.9974, so it is described here and seen in the bar screenshots."}
{"id": "win11.taskbar.bar.full", "surface": "taskbar", "kind": "state", "label": "Bar full", "order": 52, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "When the buttons no longer fit, the bar draws smaller buttons, folds the search box to its icon and shortens window labels; past that, the last buttons move into the overflow flyout, a one-row strip above the overflow button that grows by one button per window it holds."}
{"id": "win11.taskbar.bar.thumbnail-close", "surface": "taskbar", "kind": "state", "label": "Thumbnail close button", "order": 53, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "A close button appears at the top right of a preview while the pointer is over it."}
{"id": "win11.taskbar.bar.drag-reorder", "surface": "taskbar", "kind": "gesture", "label": "Drag to reorder", "order": 54, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "Dragging a task button along the bar moves it; the others slide aside."}
{"id": "win11.taskbar.bar.drag-file-switch", "surface": "taskbar", "kind": "gesture", "label": "Drag a file over a button", "order": 55, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "Holding a dragged file over a task button brings that app's window forward so the file can be dropped in it."}
{"id": "win11.taskbar.bar.middle-click-new", "surface": "taskbar", "kind": "gesture", "label": "Middle-click for a new window", "order": 56, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "Middle-clicking a task button opens a new window of that app."}
{"id": "win11.taskbar.bar.shift-click-new", "surface": "taskbar", "kind": "gesture", "label": "Shift-click for a new window", "order": 57, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "Shift with a click opens a new window of that app."}
{"id": "win11.taskbar.bar.ctrl-click-cycle", "surface": "taskbar", "kind": "gesture", "label": "Ctrl-click to cycle", "order": 58, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "Ctrl with a click on a grouped button brings its windows forward one after another."}
{"id": "win11.taskbar.bar.auto-hide", "surface": "taskbar", "kind": "gesture", "label": "Auto-hide reveal", "order": 59, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.bar", "behaviour": "With auto-hide on, the bar slides away and comes back when the pointer reaches the screen edge it sits on."}
{"id": "win11.taskbar.grouped-jump-list.recent", "surface": "taskbar", "kind": "state", "label": "Recent group", "order": 100, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.grouped-jump-list", "behaviour": "Below Pinned, a Recent group lists the files the app opened last, under the same heading and row shape; each row offers a pin button on hover."}
