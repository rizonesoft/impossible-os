{"id": "win11.taskbar.tray.clock-lines", "surface": "taskbar", "kind": "state", "label": "Clock lines", "order": 51, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.tray", "behaviour": "Two lines, the time over the short date, right-aligned; one line on a small bar."}
{"id": "win11.taskbar.tray.clock-date-forms", "surface": "taskbar", "kind": "state", "label": "Clock date forms", "order": 52, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.tray", "behaviour": "The date follows the region's short date format; the tooltip shows the long date and the time."}
{"id": "win11.taskbar.tray.bell-states", "surface": "taskbar", "kind": "state", "label": "Notification bell states", "order": 53, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.tray", "behaviour": "A bell; a count badge with unread notifications; a moon with Do not disturb on, as on this machine."}
{"id": "win11.taskbar.tray.microphone-in-use", "surface": "taskbar", "kind": "state", "label": "Microphone in use", "order": 54, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.tray", "behaviour": "A microphone glyph joins the tray while an app records; hover names the app."}
{"id": "win11.taskbar.tray.location-in-use", "surface": "taskbar", "kind": "state", "label": "Location in use", "order": 55, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.tray", "behaviour": "A location glyph joins the tray while an app reads the location."}
{"id": "win11.taskbar.tray.screen-capture", "surface": "taskbar", "kind": "state", "label": "Screen capture", "order": 56, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.tray", "behaviour": "A capture glyph joins the tray while the screen is shared or recorded."}
{"id": "win11.taskbar.tray.flyout-drag", "surface": "taskbar", "kind": "gesture", "label": "Drag between flyout and bar", "order": 60, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.tray", "behaviour": "An icon dragged from the hidden icons flyout onto the tray stays there; one dragged into the flyout hides."}
{"id": "win11.taskbar.tray.show-desktop-click", "surface": "taskbar", "kind": "gesture", "label": "Show desktop", "order": 61, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.tray", "behaviour": "A click on the far right edge minimizes every window; a second click restores them; peek on hover is a setting, off by default."}
{"id": "win11.taskbar.tray.group-click", "surface": "taskbar", "kind": "gesture", "label": "Network, volume and battery", "order": 62, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.taskbar.tray", "behaviour": "One click on the group opens Quick Settings; the clock and bell open the notification centre and calendar."}
