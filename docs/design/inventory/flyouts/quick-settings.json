{"id": "win11.flyouts.quick-settings.open", "surface": "flyouts", "kind": "gesture", "label": "Opening", "order": 40, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.flyouts.quick-settings", "behaviour": "Win+A, or a click on the tray's network, volume and battery group, opens Quick Settings; Esc or a click outside closes it.", "disposition": "build"}
{"id": "win11.flyouts.quick-settings.keyboard", "surface": "flyouts", "kind": "gesture", "label": "Keyboard path", "order": 41, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.flyouts.quick-settings", "behaviour": "Tab moves between the grid, the pager, the volume row and the footer; arrows move between tiles; Space or Enter toggles a tile or opens its page; Back or Esc leaves a page.", "disposition": "build"}
{"id": "win11.flyouts.quick-settings.tile-states", "surface": "flyouts", "kind": "gesture", "label": "Tile states", "order": 42, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.flyouts.quick-settings", "behaviour": "A toggle tile is off or on (Energy saver, Night light, Nearby sharing, Live captions); a tile with a page opens it (Accessibility, Cast, Project); a tile whose hardware is missing is absent, and the mute button is unavailable with no audio device.", "disposition": "build"}
{"id": "win11.flyouts.quick-settings.live-captions", "surface": "flyouts", "kind": "gesture", "label": "Live captions on", "order": 43, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.flyouts.quick-settings", "behaviour": "Turning Live captions on closes Quick Settings and opens the captions bar.", "disposition": "build"}
{"id": "win11.flyouts.quick-settings.pager", "surface": "flyouts", "kind": "gesture", "label": "Pages of tiles", "order": 44, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.flyouts.quick-settings", "behaviour": "Tiles beyond six go to further pages; the pager's dots and the wheel move between them, the pager disables Previous on the first page and Next on the last.", "disposition": "build"}
{"id": "win11.flyouts.quick-settings.edit-mode", "surface": "flyouts", "kind": "region", "label": "No edit mode", "order": 60, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.flyouts.quick-settings", "behaviour": "This build has no edit control: the footer holds only All settings and a tile's menu holds only Go to Settings, so tiles cannot be pinned, unpinned or moved.", "disposition": "equivalent"}
{"id": "win11.flyouts.quick-settings.hardware-tiles", "surface": "flyouts", "kind": "region", "label": "Tiles the reference machine lacks", "order": 61, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.flyouts.quick-settings", "behaviour": "Wi-Fi, Bluetooth, VPN, Airplane mode, Mobile hotspot, Rotation lock and the battery read-out need hardware the reference VM does not have; the laptop file shows those a stand-in machine can provide.", "disposition": "build"}
{"id": "win11.flyouts.quick-settings.media-card", "surface": "flyouts", "kind": "region", "label": "Media card", "order": 62, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.flyouts.quick-settings", "behaviour": "The media card above the tiles shows only while an app plays media with a transport session; the reference machine plays none, so it is absent.", "disposition": "build"}
{"id": "win11.flyouts.quick-settings.brightness", "surface": "flyouts", "kind": "region", "label": "Brightness slider", "order": 63, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.flyouts.quick-settings", "behaviour": "Absent on the reference VM, whose display has no brightness control, as on a desktop monitor; the laptop file shows it.", "disposition": "build"}
{"id": "win11.flyouts.quick-settings.focus", "surface": "flyouts", "kind": "region", "label": "Focus", "order": 64, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.flyouts.quick-settings", "behaviour": "Focus is not a tile on this build: it starts from the notification center's clock area.", "disposition": "build"}
{"id": "win11.flyouts.quick-settings.project-modes", "surface": "flyouts", "kind": "region", "label": "Projection modes", "order": 65, "source": "hand:26300.9974", "capturedFrom": "26300.9974", "parent": "win11.flyouts.quick-settings", "behaviour": "The Project page lists PC screen only, Duplicate, Extend and Second screen only when the display driver can project; the reference VM's cannot, so the page shows its error line instead.", "disposition": "build"}
