 "profile": {
  "$schema_version": 1,
  "_comment": "The system SVG profile: what a system icon may contain so that every Impossible OS renderer (the SVG runtime and the host converter) draws it the same way. scripts/brand_contract.py publishes this file inside docs/design/brand-contract.json and enforces it; todo/answers.md Q64 records the limits.",
  "drawing_attributes": [
   "clip-path",
   "clip-rule",
   "fill",
