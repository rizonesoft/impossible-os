   "fill-rule",
   "id",
   "opacity",
   "stroke",
   "stroke-dasharray",
   "stroke-dashoffset",
   "stroke-linecap",
   "stroke-linejoin",
   "stroke-miterlimit",
   "stroke-opacity",
   "stroke-width",
   "transform"
  ],
  "elements": {
   "circle": {
    "attributes": [
     "cx",
     "cy",
     "r"
    ],
    "drawing": true
   },
   "clipPath": {
    "attributes": [
