      "taskbar": { "tint": "#1C1C1C", "tint_opacity": 184, "luminosity_opacity": 150, "blur": 24, "noise": 6 },
      "start":   { "tint": "#202020", "tint_opacity": 196, "luminosity_opacity": 160, "blur": 30, "noise": 6 },
      "flyout":  { "tint": "#2C2C2C", "tint_opacity": 204, "luminosity_opacity": 170, "blur": 30, "noise": 6 },
