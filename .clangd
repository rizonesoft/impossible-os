# Impossible OS — clangd configuration for kernel freestanding environment
# This file ensures clangd understands our cross-compilation target
# and does not inject host standard library headers.

CompileFlags:
  Add:
    - "--target=x86_64-elf"
    - "-nostdlib"
    - "-nostdinc"
    - "-ffreestanding"
    - "-mno-red-zone"

Index:
  Background: Build

Diagnostics:
  # Strict mode surfaces phantom-include findings to scripts/lint.sh
  # Check 8 (via scripts/todo-graph/check_phantom_includes.py over the
  # lsp-bridge MCP diagnostics tool). Editors see the same findings;
  # legitimate cases use `// PHANTOM-INCLUDE-OK: <reason>` on the same
  # line as the #include to suppress.
  UnusedIncludes: Strict
  MissingIncludes: None
