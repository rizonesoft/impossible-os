            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/numeric_todo_shorthand.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/scope_gap_marker.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/test_side_effect_ban.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/bare_section_refs.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/notes_bloat_check.py",
