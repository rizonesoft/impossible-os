            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/codex_model_flag_block.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/section_commit_gate.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/phase1_evidence_gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
