{
  "permissions": {
    "allow": [
      "Bash(grep -n \"bus fault\\\\|crash\\\\|hang\\\\|timeout\" /home/derickpayne/impossible-os/src/kernel/drivers/*.c)",
      "Bash(grep -E \"\\\\.\\(c|h\\)$\")",
      "Bash(grep -l \"## OS Comparison\" todo/**/*.md)",
      "Bash(TIMEOUT=30 bash scripts/test.sh QUIET=1:*)",
