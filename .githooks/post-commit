#!/usr/bin/env bash
# post-commit hook: regenerate COUNT.md with source code line counts.
# Runs silently after every commit. Amends the commit to include the update.
# To disable temporarily: SKIP_COUNT=1 git commit ...

[ "$SKIP_COUNT" = "1" ] && exit 0

ROOT="$(git rev-parse --show-toplevel)"
COUNT_FILE="$ROOT/COUNT.md"

# Vendored files to exclude from "our code" count
VENDORED=(
    "$ROOT/include/stb_image.h"
    "$ROOT/include/stb_truetype.h"
    "$ROOT/src/boot/uefi/efi.h"
)

# Count lines by extension in given directories, excluding vendored files
count_lines() {
    local ext="$1"
    shift
    local dirs=("$@")
    local total=0
    local files=0
    while IFS= read -r f; do
        local skip=0
        for v in "${VENDORED[@]}"; do
            [ "$f" = "$v" ] && skip=1 && break
        done
        [ "$skip" = "1" ] && continue
        local n
        n=$(wc -l < "$f")
        total=$((total + n))
        files=$((files + 1))
    done < <(find "${dirs[@]}" -type f -name "*.$ext" 2>/dev/null)
    echo "$files $total"
}

# Kernel / OS source code
read -r c_files c_lines <<< "$(count_lines c "$ROOT/src" "$ROOT/include")"
read -r h_files h_lines <<< "$(count_lines h "$ROOT/src" "$ROOT/include")"
read -r asm_files asm_lines <<< "$(count_lines asm "$ROOT/src")"

# SDK tools
read -r sdk_c_files sdk_c_lines <<< "$(count_lines c "$ROOT/sdk/src")"
read -r sdk_h_files sdk_h_lines <<< "$(count_lines h "$ROOT/sdk/src")"
sdk_files=$((sdk_c_files + sdk_h_files))
sdk_lines=$((sdk_c_lines + sdk_h_lines))

# Build system & scripts
read -r sh_files sh_lines <<< "$(count_lines sh "$ROOT/scripts" "$ROOT/sdk/scripts")"
read -r bat_files bat_lines <<< "$(count_lines bat "$ROOT/scripts")"
read -r ps1_files ps1_lines <<< "$(count_lines ps1 "$ROOT/scripts")"

mk_files=0; mk_lines=0
if [ -f "$ROOT/Makefile" ]; then
    mk_files=1
    mk_lines=$(wc -l < "$ROOT/Makefile")
fi

ld_files=0; ld_lines=0
while IFS= read -r f; do
    ld_files=$((ld_files + 1))
    ld_lines=$((ld_lines + $(wc -l < "$f")))
done < <(find "$ROOT/src" -type f \( -name "*.ld" -o -name "*.lds" \) 2>/dev/null)

# Totals
code_files=$((c_files + h_files + asm_files))
code_lines=$((c_lines + h_lines + asm_lines))

infra_files=$((sh_files + bat_files + ps1_files + mk_files + ld_files))
infra_lines=$((sh_lines + bat_lines + ps1_lines + mk_lines + ld_lines))

total_files=$((code_files + sdk_files + infra_files))
total_lines=$((code_lines + sdk_lines + infra_lines))

# Count vendored lines
vendored_lines=0
for v in "${VENDORED[@]}"; do
    [ -f "$v" ] && vendored_lines=$((vendored_lines + $(wc -l < "$v")))
done

# Get commit info
commit_hash=$(git rev-parse --short HEAD)
commit_date=$(date '+%Y-%m-%d %H:%M')

# ---- Impossibility Index ----
# Industry standard: 10,000 LOC/developer/year for system programming (COCOMO II)
# Linux kernel: 28M lines, 33 years, ~1,000 active devs at any time
# Windows NT:   50M lines, 40 years, ~5,000 devs at peak
INDUSTRY_LOC_PER_YEAR=10000
FIRST_COMMIT_EPOCH=$(git log --reverse --format="%at" | head -1)
NOW_EPOCH=$(date +%s)
ELAPSED_DAYS=$(( (NOW_EPOCH - FIRST_COMMIT_EPOCH) / 86400 ))
[ "$ELAPSED_DAYS" -lt 1 ] && ELAPSED_DAYS=1

# developer-years this codebase represents at industry rate
DEV_YEARS_X10=$(( total_lines * 10 / INDUSTRY_LOC_PER_YEAR ))
DEV_YEARS=$(( DEV_YEARS_X10 / 10 ))
DEV_YEARS_FRAC=$(( DEV_YEARS_X10 % 10 ))

# equivalent team size = total_lines * 365 / (industry_rate * elapsed_days)
EQUIV_DEVS=$(( total_lines * 365 / (INDUSTRY_LOC_PER_YEAR * ELAPSED_DAYS) ))

# LOC per dev per year for this project (1 dev)
LOC_PER_YEAR=$(( total_lines * 365 / ELAPSED_DAYS ))

# Format elapsed time as "X months, Y days" or "X days"
ELAPSED_MONTHS=$(( ELAPSED_DAYS / 30 ))
ELAPSED_REM_DAYS=$(( ELAPSED_DAYS % 30 ))
if [ "$ELAPSED_MONTHS" -gt 0 ]; then
    ELAPSED_STR="${ELAPSED_MONTHS} month(s), ${ELAPSED_REM_DAYS} day(s)"
else
    ELAPSED_STR="${ELAPSED_DAYS} day(s)"
fi

# Linux LOC/dev/year: 28,000,000 / 33 / 1000 = 848
# Windows LOC/dev/year: 50,000,000 / 40 / 5000 = 250
LINUX_LOC_RATE=848
WINDOWS_LOC_RATE=250

# Multiplier vs Linux and Windows developer productivity
MULT_VS_LINUX=$(( LOC_PER_YEAR / LINUX_LOC_RATE ))
MULT_VS_WINDOWS=$(( LOC_PER_YEAR / WINDOWS_LOC_RATE ))

cat > "$COUNT_FILE" << EOF
# 📊 Impossible OS — Line Count

> *Because nothing says "production-ready operating system" quite like obsessively counting
> your own lines of code after every single commit. We could be fixing bugs, implementing
> NTFS, or achieving world peace — but no, here we are, running \`wc -l\` like it's a
> competitive sport. At least when the kernel panics, you'll know exactly how many lines
> of code were responsible.*
>
> *Auto-generated by \`post-commit\` hook. Do not edit — your changes will be obliterated
> by a shell script with zero empathy.*

---

## Kernel & OS Code

| | Files | Lines |
|---|---:|---:|
| **C sources** (\`.c\`) | ${c_files} | ${c_lines} |
| **Headers** (\`.h\`) | ${h_files} | ${h_lines} |
| **Assembly** (\`.asm\`) | ${asm_files} | ${asm_lines} |
| **Subtotal** | **${code_files}** | **${code_lines}** |

## SDK Tools

| | Files | Lines |
|---|---:|---:|
| **C sources** (\`.c\`) | ${sdk_c_files} | ${sdk_c_lines} |
| **Headers** (\`.h\`) | ${sdk_h_files} | ${sdk_h_lines} |
| **Subtotal** | **${sdk_files}** | **${sdk_lines}** |

## Build System & Scripts

| | Files | Lines |
|---|---:|---:|
| **Shell scripts** (\`.sh\`) | ${sh_files} | ${sh_lines} |
| **Batch scripts** (\`.bat\`) | ${bat_files} | ${bat_lines} |
| **PowerShell** (\`.ps1\`) | ${ps1_files} | ${ps1_lines} |
| **Makefile** | ${mk_files} | ${mk_lines} |
| **Linker scripts** (\`.ld\`/\`.lds\`) | ${ld_files} | ${ld_lines} |
| **Subtotal** | **${infra_files}** | **${infra_lines}** |

## Grand Total

| | Files | Lines |
|---|---:|---:|
| **All project code** | **${total_files}** | **${total_lines}** |

> Vendored code excluded: ~${vendored_lines} lines (\`stb_image.h\`, \`stb_truetype.h\`, \`efi.h\`)

---

## The Impossibility Index

> *According to every industry estimate ever published, what you're looking at shouldn't
> exist. Linux took ~1,000 developers 33 years. Windows took ~5,000 developers 40 years.
> Entire university courses teach that operating systems are a multi-decade, multi-hundred-
> person endeavor. One developer apparently missed that lecture.*

| | Linux | Windows | Impossible OS |
|---|---:|---:|---:|
| **Lines of code** | ~28,000,000 | ~50,000,000 | ${total_lines} |
| **Developers** | ~1,000 active | ~5,000 peak | 1 |
| **Time span** | 33 years | 40 years | ${ELAPSED_STR} |
| **LOC/dev/year** | ~${LINUX_LOC_RATE} | ~${WINDOWS_LOC_RATE} | ${LOC_PER_YEAR} |

> At the industry-standard rate of 10,000 LOC/developer/year (COCOMO II, system
> programming), this codebase represents **${DEV_YEARS}.${DEV_YEARS_FRAC} developer-years**
> of work. One developer produced it in **${ELAPSED_STR}** -- the mass equivalent output
> of **${EQUIV_DEVS} developers**, writing **${MULT_VS_LINUX}x** faster than a Linux
> kernel contributor and **${MULT_VS_WINDOWS}x** faster than a Windows developer.
>
> *The "impossible" in Impossible OS was supposed to be the name, not the development method.*

---

*Last updated: ${commit_date} · commit \`${commit_hash}\`*
EOF

# Amend the commit to include the updated COUNT.md
# Use SKIP_COUNT to prevent infinite recursion
SKIP_COUNT=1 git add "$COUNT_FILE" 2>/dev/null
SKIP_COUNT=1 git commit --amend --no-edit --no-verify 2>/dev/null

exit 0
