#!/usr/bin/env bash
# post-commit hook: regenerate COUNT.md with source code line counts.
# Runs silently after every commit. Amends the commit to include the update.
# To disable temporarily: SKIP_COUNT=1 git commit ...

[ "$SKIP_COUNT" = "1" ] && exit 0

ROOT="$(git rev-parse --show-toplevel)"
COUNT_FILE="$ROOT/COUNT.md"

# Vendored files to exclude from "our code" count
VENDORED=(
    "$ROOT/include/stb_image.h"
    "$ROOT/include/stb_truetype.h"
    "$ROOT/src/boot/uefi/efi.h"
)

# Count lines by extension, excluding vendored files
count_lines() {
    local ext="$1"
    local total=0
    local files=0
    while IFS= read -r f; do
        local skip=0
        for v in "${VENDORED[@]}"; do
            [ "$f" = "$v" ] && skip=1 && break
        done
        [ "$skip" = "1" ] && continue
        local n
        n=$(wc -l < "$f")
        total=$((total + n))
        files=$((files + 1))
    done < <(find "$ROOT/src" "$ROOT/include" -type f -name "*.$ext" 2>/dev/null)
    echo "$files $total"
}

read -r c_files c_lines <<< "$(count_lines c)"
read -r h_files h_lines <<< "$(count_lines h)"
read -r asm_files asm_lines <<< "$(count_lines asm)"

total_files=$((c_files + h_files + asm_files))
total_lines=$((c_lines + h_lines + asm_lines))

# Count vendored lines
vendored_lines=0
for v in "${VENDORED[@]}"; do
    [ -f "$v" ] && vendored_lines=$((vendored_lines + $(wc -l < "$v")))
done

# Get commit info
commit_hash=$(git rev-parse --short HEAD)
commit_date=$(date '+%Y-%m-%d %H:%M')

cat > "$COUNT_FILE" << EOF
# 📊 Impossible OS — Line Count

> *Because nothing says "production-ready operating system" quite like obsessively counting
> your own lines of code after every single commit. We could be fixing bugs, implementing
> NTFS, or achieving world peace — but no, here we are, running \`wc -l\` like it's a
> competitive sport. At least when the kernel panics, you'll know exactly how many lines
> of code were responsible.*
>
> *Auto-generated by \`post-commit\` hook. Do not edit — your changes will be obliterated
> by a shell script with zero empathy.*

---

## Summary

| | Files | Lines |
|---|---:|---:|
| **C sources** (\`.c\`) | ${c_files} | ${c_lines} |
| **Headers** (\`.h\`) | ${h_files} | ${h_lines} |
| **Assembly** (\`.asm\`) | ${asm_files} | ${asm_lines} |
| **Total (our code)** | **${total_files}** | **${total_lines}** |

> Vendored code excluded: ~${vendored_lines} lines (\`stb_image.h\`, \`stb_truetype.h\`, \`efi.h\`)

---

*Last updated: ${commit_date} · commit \`${commit_hash}\`*
EOF

# Amend the commit to include the updated COUNT.md
# Use SKIP_COUNT to prevent infinite recursion
SKIP_COUNT=1 git add "$COUNT_FILE" 2>/dev/null
SKIP_COUNT=1 git commit --amend --no-edit --no-verify 2>/dev/null

exit 0
