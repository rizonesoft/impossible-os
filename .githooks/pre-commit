#!/usr/bin/env bash
# ============================================================================
# .githooks/pre-commit -- Run scripts/lint.sh before commit
#
# Previous behavior (pre-2026-04-19): filtered to staged .c/.h files only,
# which let numeric-TODO shorthand and trailing-whitespace violations in
# .sh, .yml, .md, and .json ship because the filter skipped them entirely.
# TODO-02 §9's test-ai-system.sh was committed with 11 lint errors because
# of that gap; CI would have caught it, but a local pre-commit hook that
# only covers C/H is a false sense of safety.
#
# Current behavior: run `scripts/lint.sh` with no args (full-repo scan) when
# anything is staged. This matches CI exactly -- if lint passes here, it
# passes in `.github/workflows/build.yml` Run style lint step.
#
# Install: git config core.hooksPath .githooks
#   or:    bash scripts/install-hooks.sh
# ============================================================================

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# If nothing is staged (e.g., `git commit --allow-empty`), skip.
if git diff --cached --quiet --exit-code 2>/dev/null; then
    exit 0
fi

echo ""
echo "Pre-commit: running scripts/lint.sh (full-repo, matches CI)..."
echo ""

# AN AMBIENT `SKIP_LINT_*` MUST NOT WEAKEN THE COMMIT GATE. Those variables are
# lint's own per-check dials and a deliberate `SKIP_LINT_SECRETS=1 bash
# scripts/lint.sh` must keep working -- so they are cleared HERE, on the gate
# path, rather than inside lint.sh where clearing them would break the dial.
#
# Measured 2026-08-08 while auditing the same leak that bit `test-tooling.sh`:
# four checks (including the tracked-secret guard) disabled themselves from an
# operator's exported environment and the commit gate still passed. lint does
# announce each one -- `Check 16 ... skipped via SKIP_LINT_SECRETS=1` -- but it
# announces into a 17-line warning block that nobody reads at commit time, and
# "visible in principle" is not a gate. CI runs with a clean environment, so
# this only ever diverged locally, in the weakening direction.
_PC_CLEARED=()
for _pc_var in $(compgen -v 2>/dev/null | grep -E '^SKIP_LINT_' || true); do
    _PC_CLEARED+=("$_pc_var")
    unset "$_pc_var" 2>/dev/null || true
done
if [ "${#_PC_CLEARED[@]}" -gt 0 ]; then
    echo "Pre-commit: ignoring inherited lint opt-out(s) for the gate: ${_PC_CLEARED[*]}"
    echo "  (run 'bash scripts/lint.sh' directly if you need them honoured)"
fi
unset _pc_var

if ! bash "$REPO_ROOT/scripts/lint.sh"; then
    echo ""
    echo -e "\033[31mFix lint errors before committing\033[0m"
    echo "  Hint: 'bash scripts/lint.sh' shows all violations."
    echo "  Hint: numeric TODO shorthand (TODO-NN §N, DNN TNN) must stay inside todo/."
    echo "        Use capability names or anchor links in other files."
    exit 1
fi

# Overnight-runner control-plane gate (2026-07-11): the runner broke
# repeatedly because a control-plane change (guard / launcher / arm /
# circuit-breaker) could commit and push with green hooks -- its tests
# were wired into nothing. If this commit touches the control-plane
# manifest, run the runner test suite BEFORE the commit lands. Fast
# (~2s, 12 tests) and only fires when those files are staged, so it
# gates the operator AND the runner's own section commits.
CP_MATCH="$REPO_ROOT/scripts/overnight/control-plane-match.sh"
if [ -f "$CP_MATCH" ]; then
    CP_HITS="$(git diff --cached --name-only | bash "$CP_MATCH" || true)"
    if [ -n "$CP_HITS" ]; then
        echo ""
        echo "Pre-commit: control-plane change detected -- running runner test suite:"
        printf '%s\n' "$CP_HITS" | sed 's/^/  touched: /'
        if ! bash "$REPO_ROOT/scripts/overnight/tests/run-all.sh"; then
            echo ""
            echo -e "\033[31mRunner test suite failed -- control-plane commit blocked\033[0m"
            echo "  A change to the overnight-runner control plane broke its tests."
            echo "  Fix the regression (or the test) before committing."
            echo "  Opt-out (last resort): SKIP_RUNNER_SUITE=1 git commit ..."
            [ "${SKIP_RUNNER_SUITE:-}" = "1" ] || exit 1
            echo -e "\033[33m  SKIP_RUNNER_SUITE=1 set -- suite failure overridden\033[0m"
        fi
    fi
fi

# Hook-manifest gate (2026-07-26): .claude/hooks/MANIFEST.md is the single
# source of truth for what hooks exist and what each one does, and
# scripts/audit-hooks.sh already detects drift correctly -- but its only
# caller was scripts/test-tooling.sh, which runs solely in CI on pushes to
# main and PRs against it. Work on a long-lived branch therefore never
# triggered it: two cost-control hooks (codex_wait_discipline,
# websearch_offload_gate) shipped undocumented and the drift sat unnoticed
# across 291 commits. Running the audit HERE closes that window -- it is
# 0.5s and only fires when hook files or settings.json are staged, so a new
# hook cannot land without its manifest row regardless of CI reachability.
HOOK_AUDIT="$REPO_ROOT/scripts/audit-hooks.sh"
if [ -f "$HOOK_AUDIT" ]; then
    HOOK_HITS="$(git diff --cached --name-only \
        | grep -E '^\.claude/(hooks/|settings\.json$)' || true)"
    if [ -n "$HOOK_HITS" ]; then
        echo ""
        echo "Pre-commit: hook surface changed -- auditing MANIFEST.md:"
        printf '%s\n' "$HOOK_HITS" | sed 's/^/  touched: /'
        if ! bash "$HOOK_AUDIT" >/dev/null 2>&1; then
            echo ""
            echo -e "\033[31mHook manifest drift -- commit blocked\033[0m"
            bash "$HOOK_AUDIT" 2>&1 | grep -E 'DRIFT|FAIL' | sed 's/^/  /'
            echo "  Every hook needs a MANIFEST.md row (file, event, kind, opt-out,"
            echo "  purpose); every installed plugin needs its events enumerated."
            echo "  Opt-out (last resort): SKIP_HOOK_AUDIT=1 git commit ..."
            [ "${SKIP_HOOK_AUDIT:-}" = "1" ] || exit 1
            echo -e "\033[33m  SKIP_HOOK_AUDIT=1 set -- manifest drift overridden\033[0m"
        fi
    fi
fi

# TODO-08 §4: section-commit gate -- enforced at the final-index point
# of git's own pre-commit. The harness PreToolUse hook is the
# convenience layer; this is the load-bearing one for chained shapes
# like `git add foo && git commit -m bar` where the harness sees only
# pre-`git add` staging (Codex C1 partial fix).
GATE="$REPO_ROOT/.claude/hooks/section_commit_gate.py"
if [ -f "$GATE" ]; then
    if ! python3 "$GATE" --git-hook-mode; then
        echo ""
        echo -e "\033[31mSection-commit gate refused this commit\033[0m"
        echo "  See above for missing build / Codex / receiving-review evidence."
        echo "  Opt-out: SKIP_REVIEW_HOOK=1 SKIP_REVIEW_HOOK_REASON=\"...\" git commit ..."
        exit 1
    fi
fi

# TODO item-length backstop. `todo_item_line_length.py` is a PreToolUse hook and
# it works -- but it only sees Edit/Write, and both the operator and the
# unattended runner routinely write TODO content through a `python3` heredoc or
# rewrite script executed via Bash, which no PreToolUse hook observes. Measured
# 2026-07-28: five over-cap items landed AFTER that hook shipped, in exactly the
# two commits that used the script path (8ac3c976 operator, c64bec7c runner).
# Everything reaches a commit, so this is the choke point that closes the bypass.
# Only ADDED lines are judged -- the ~1,407 legacy violations are left alone.
TODO_STAGED="$REPO_ROOT/scripts/todo-staged-check.py"
if [ -f "$TODO_STAGED" ]; then
    if ! python3 "$TODO_STAGED"; then
        echo -e "\033[31mPre-commit: over-cap TODO checklist item(s) in this commit\033[0m"
        echo "  Opt-out (last resort): SKIP_TODO_STAGED_CHECK=1 git commit ..."
        exit 1
    fi
fi

echo ""
echo -e "\033[32mPre-commit lint passed\033[0m"
exit 0
