#!/usr/bin/env bash
# ============================================================================
# .githooks/pre-commit — Lint staged .c and .h files before commit
#
# Install: git config core.hooksPath .githooks
# ============================================================================

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Collect staged .c and .h files (ignore deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d -- '*.c' '*.h' 2>/dev/null || true)

if [ -z "$STAGED_FILES" ]; then
    # No C/H files staged — nothing to lint
    exit 0
fi

# Convert to absolute paths (one per line → space-separated)
ABS_FILES=""
while IFS= read -r file; do
    ABS_FILES="$ABS_FILES $REPO_ROOT/$file"
done <<< "$STAGED_FILES"

FILE_COUNT=$(echo "$STAGED_FILES" | wc -l)

echo ""
echo "Pre-commit: linting $FILE_COUNT staged C/H file(s)..."
echo ""

# Run the project linter on the staged files only
if bash "$REPO_ROOT/scripts/lint.sh" $ABS_FILES; then
    echo ""
    echo -e "\033[32mPre-commit lint passed\033[0m"
    exit 0
else
    echo ""
    echo -e "\033[31mFix lint errors before committing\033[0m"
    echo "  Hint: run 'bash scripts/lint.sh' to see all violations"
    exit 1
fi
