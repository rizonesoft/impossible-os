#!/usr/bin/env bash
# ============================================================================
# .githooks/pre-commit -- Run scripts/lint.sh before commit
#
# Previous behavior (pre-2026-04-19): filtered to staged .c/.h files only,
# which let numeric-TODO shorthand and trailing-whitespace violations in
# .sh, .yml, .md, and .json ship because the filter skipped them entirely.
# TODO-02 §9's test-ai-system.sh was committed with 11 lint errors because
# of that gap; CI would have caught it, but a local pre-commit hook that
# only covers C/H is a false sense of safety.
#
# Current behavior: run `scripts/lint.sh` with no args (full-repo scan) when
# anything is staged. This matches CI exactly -- if lint passes here, it
# passes in `.github/workflows/build.yml` Run style lint step.
#
# Install: git config core.hooksPath .githooks
#   or:    bash scripts/install-hooks.sh
# ============================================================================

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# If nothing is staged (e.g., `git commit --allow-empty`), skip.
if git diff --cached --quiet --exit-code 2>/dev/null; then
    exit 0
fi

echo ""
echo "Pre-commit: running scripts/lint.sh (full-repo, matches CI)..."
echo ""

if ! bash "$REPO_ROOT/scripts/lint.sh"; then
    echo ""
    echo -e "\033[31mFix lint errors before committing\033[0m"
    echo "  Hint: 'bash scripts/lint.sh' shows all violations."
    echo "  Hint: numeric TODO shorthand (TODO-NN §N, DNN TNN) must stay inside todo/."
    echo "        Use capability names or anchor links in other files."
    exit 1
fi

# Overnight-runner control-plane gate (2026-07-11): the runner broke
# repeatedly because a control-plane change (guard / launcher / arm /
# circuit-breaker) could commit and push with green hooks -- its tests
# were wired into nothing. If this commit touches the control-plane
# manifest, run the runner test suite BEFORE the commit lands. Fast
# (~2s, 12 tests) and only fires when those files are staged, so it
# gates the operator AND the runner's own section commits.
CP_MATCH="$REPO_ROOT/scripts/overnight/control-plane-match.sh"
if [ -f "$CP_MATCH" ]; then
    CP_HITS="$(git diff --cached --name-only | bash "$CP_MATCH" || true)"
    if [ -n "$CP_HITS" ]; then
        echo ""
        echo "Pre-commit: control-plane change detected -- running runner test suite:"
        printf '%s\n' "$CP_HITS" | sed 's/^/  touched: /'
        if ! bash "$REPO_ROOT/scripts/overnight/tests/run-all.sh"; then
            echo ""
            echo -e "\033[31mRunner test suite failed -- control-plane commit blocked\033[0m"
            echo "  A change to the overnight-runner control plane broke its tests."
            echo "  Fix the regression (or the test) before committing."
            echo "  Opt-out (last resort): SKIP_RUNNER_SUITE=1 git commit ..."
            [ "${SKIP_RUNNER_SUITE:-}" = "1" ] || exit 1
            echo -e "\033[33m  SKIP_RUNNER_SUITE=1 set -- suite failure overridden\033[0m"
        fi
    fi
fi

# TODO-08 §4: section-commit gate -- enforced at the final-index point
# of git's own pre-commit. The harness PreToolUse hook is the
# convenience layer; this is the load-bearing one for chained shapes
# like `git add foo && git commit -m bar` where the harness sees only
# pre-`git add` staging (Codex C1 partial fix).
GATE="$REPO_ROOT/.claude/hooks/section_commit_gate.py"
if [ -f "$GATE" ]; then
    if ! python3 "$GATE" --git-hook-mode; then
        echo ""
        echo -e "\033[31mSection-commit gate refused this commit\033[0m"
        echo "  See above for missing build / Codex / receiving-review evidence."
        echo "  Opt-out: SKIP_REVIEW_HOOK=1 SKIP_REVIEW_HOOK_REASON=\"...\" git commit ..."
        exit 1
    fi
fi

echo ""
echo -e "\033[32mPre-commit lint passed\033[0m"
exit 0
