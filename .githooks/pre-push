#!/bin/bash
# =============================================================================
# pre-push hook -- Run kernel unit tests before allowing push
#
# Runs the full test suite (328+ tests) via QEMU TCG headless.
# Blocks push if any test fails. Bypass with: git push --no-verify
#
# Typical runtime: ~10s (build + TCG boot + tests)
# =============================================================================

REPO_ROOT="$(git rev-parse --show-toplevel)"
ZERO="0000000000000000000000000000000000000000"

# Read push info from stdin (format: local_ref local_sha remote_ref remote_sha)
HAS_SOURCE=false
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "$ZERO" ]; then
        continue  # branch delete
    fi

    # Determine diff range
    if [ "$remote_sha" = "$ZERO" ]; then
        RANGE="$local_sha"
    else
        RANGE="$remote_sha..$local_sha"
    fi

    # Check if any kernel source files changed
    CHANGED=$(git diff --name-only "$RANGE" 2>/dev/null)
    if echo "$CHANGED" | grep -qE '\.(c|h|asm|ld)$'; then
        HAS_SOURCE=true
        break
    fi
done

if [ "$HAS_SOURCE" = false ]; then
    exit 0
fi

echo "[pre-push] Running kernel tests..."

# Kill any stale QEMU to avoid disk lock conflicts
pkill -9 -f qemu-system-x86_64 2>/dev/null
sleep 1

TIMEOUT=30 bash "$REPO_ROOT/scripts/test.sh" QUIET=1
EXIT=$?

if [ "$EXIT" -ne 0 ]; then
    echo ""
    echo "[pre-push] BLOCKED -- tests failed. Fix before pushing."
    echo "[pre-push] Bypass with: git push --no-verify"
    exit 1
fi

exit 0
