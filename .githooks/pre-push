#!/usr/bin/env bash
# =============================================================================
# .githooks/pre-push -- always-on control-plane gate + opt-in build/test gate.
#
# Two layers:
#  1. ALWAYS-ON (2026-07-11): if the pushed commits touch the overnight-runner
#     control plane (scripts/overnight/control-plane-manifest.txt), run the
#     runner test suite as a HARD gate and runner-doctor as advisory host-health.
#     This is the net for a control-plane change committed with --no-verify (the
#     pre-commit suite gate bypassed) -- it must not reach origin unproven.
#  2. OPT-IN: the heavy full build + test.sh gate, delegated to
#     scripts/hooks/pre-push, only when the sentinel .git/.impossible-os-prepush
#     exists. Toggle with:
#       bash scripts/install-hooks.sh --enable-pre-push
#       bash scripts/install-hooks.sh --disable-pre-push
# =============================================================================

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Worktree-safe: rev-parse --git-path resolves .git whether it's a directory
# (main checkout) or a file (linked worktree).
SENTINEL="$(git -C "$REPO_ROOT" rev-parse --git-path .impossible-os-prepush 2>/dev/null || echo "$REPO_ROOT/.git/.impossible-os-prepush")"

# pre-push receives the ref updates on stdin. Capture verbatim so we can both
# inspect the pushed range AND re-feed it to the delegated opt-in gate below.
STDIN_DATA="$(cat)"

EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"

# Files changed across every non-delete ref update in this push.
pushed_files() {
  local lref loid rref roid base
  while read -r lref loid rref roid; do
    [ -n "${loid:-}" ] || continue
    case "$loid" in *[!0]*) : ;; *) continue ;; esac   # local oid all-zero => deletion, skip
    case "${roid:-}" in
      *[!0]*) base="$roid" ;;                            # real remote oid
      *) base="$(git -C "$REPO_ROOT" merge-base "$loid" origin/main 2>/dev/null || echo "$EMPTY_TREE")" ;;
    esac
    git -C "$REPO_ROOT" rev-parse --quiet --verify "$base^{commit}" >/dev/null 2>&1 || base="$EMPTY_TREE"
    git -C "$REPO_ROOT" diff --name-only "$base" "$loid" 2>/dev/null || true
  done <<< "$STDIN_DATA"
}

CP_MATCH="$REPO_ROOT/scripts/overnight/control-plane-match.sh"
if [ -f "$CP_MATCH" ]; then
  CP_HITS="$(pushed_files | sort -u | bash "$CP_MATCH" || true)"
  if [ -n "$CP_HITS" ]; then
    echo ""
    echo "Pre-push: control-plane change in this push -- gating on the runner suite:"
    printf '%s\n' "$CP_HITS" | sort -u | sed 's/^/  touched: /'
    if ! bash "$REPO_ROOT/scripts/overnight/tests/run-all.sh"; then
      echo ""
      echo -e "\033[31mRunner test suite failed -- push blocked\033[0m"
      echo "  A control-plane change did not pass the overnight-runner tests."
      echo "  Opt-out (last resort): SKIP_RUNNER_SUITE=1 git push ..."
      [ "${SKIP_RUNNER_SUITE:-}" = "1" ] || exit 1
      echo -e "\033[33m  SKIP_RUNNER_SUITE=1 set -- suite failure overridden\033[0m"
    fi
    # runner-doctor is ADVISORY here: it reports LOCAL host health (toolchain,
    # codex auth, run state), which is not a property of the change being
    # pushed, so it must not block the push -- it only surfaces warnings.
    DOCTOR="$REPO_ROOT/scripts/overnight/runner-doctor.py"
    if [ -f "$DOCTOR" ]; then
      if DOUT="$(cd "$REPO_ROOT" && python3 "$DOCTOR" . 2>&1)"; then
        echo "  runner-doctor: OK"
      else
        echo -e "\033[33m  runner-doctor reports host-health issues (advisory, not blocking):\033[0m"
        printf '%s\n' "$DOUT" | tail -8 | sed 's/^/    /'
      fi
    fi
  fi
fi

# ---- REQUIRED CI-parity gate -------------------------------------------------
#
# Runs the unit suite on the engine CI actually uses -- the distro apt QEMU with
# forced TCG -- before anything leaves the machine.
#
# This is NOT the opt-in heavy gate below, and it is deliberately not opt-in.
# That one is optional because "CI already gates PRs", an assumption this repo
# proved false: a fork+exec frame-handoff bug rode 297 commits and a green local
# suite into a red CI job, because it only reproduced on the QEMU CI installs.
# The dev host runs a custom /usr/local build and never saw it. A gate that only
# runs what already passes is not a gate.
#
# Cost measured 2026-07-27: 23.8s CI-parity vs 25.6s for the default KVM run --
# indistinguishable, and marginally FASTER. There is no speed argument for
# skipping it, so it is required rather than opt-in. The KVM inner loop is
# untouched; this is a separate tier that runs once, at the push boundary.
#
# Opt-out stays available for a genuine emergency and is logged like every other
# skip: SKIP_CI_PARITY=1 git push ...
if [ "${SKIP_CI_PARITY:-}" = "1" ]; then
  echo -e "\033[33m[pre-push] SKIP_CI_PARITY=1 -- CI-parity gate skipped\033[0m"
elif [ ! -x /usr/bin/qemu-system-x86_64 ]; then
  echo -e "\033[33m[pre-push] CI-parity gate SKIPPED: /usr/bin/qemu-system-x86_64 absent\033[0m"
  echo "           CI runs 'apt-get install qemu-system-x86'; install it to enable the gate."
else
  echo "[pre-push] CI-parity gate: unit suite on the QEMU CI installs (forced TCG)..."
  if (cd "$REPO_ROOT" && CI_PARITY=1 bash scripts/test.sh QUIET=1 >/tmp/ci-parity-prepush.log 2>&1); then
    echo -e "\033[32m  CI-parity: PASS\033[0m"
  else
    echo -e "\033[31m  CI-parity gate FAILED -- this is what CI would have reported.\033[0m"
    tail -15 /tmp/ci-parity-prepush.log | sed 's/^/    /'
    echo "  Full log: /tmp/ci-parity-prepush.log"
    echo "  Opt-out (last resort): SKIP_CI_PARITY=1 git push ..."
    exit 1
  fi
fi

# ---- Opt-in heavy build/test gate --------------------------------------------
[ -f "$SENTINEL" ] || exit 0
exec "$REPO_ROOT/scripts/hooks/pre-push" "$@" <<< "$STDIN_DATA"
