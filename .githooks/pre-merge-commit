#!/usr/bin/env bash
# .githooks/pre-merge-commit -- the ASCII-dash gate for an automatic merge
# (TODO-08 section 48). git runs this hook, not pre-commit, when `git merge`
# commits on its own. MERGE_HEAD is set, so staged_dash_check.py judges the
# merge against every parent, as pre-push does; a merge that stops on a
# conflict is committed later through pre-commit. Opt-out: the hook names it.
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=.githooks/lib/dash-gate.sh
. "$REPO_ROOT/.githooks/lib/dash-gate.sh"
dash_gate
