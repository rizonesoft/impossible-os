#!/usr/bin/env bash
# .githooks/commit-msg -- the ASCII-dash gate for a merge that git commits by
# itself (TODO-08 section 48). `git merge` runs pre-merge-commit, not
# pre-commit, and runs it before MERGE_HEAD exists, so that hook could judge
# the merge only against HEAD. commit-msg runs after MERGE_HEAD is written and
# before HEAD moves, so staged_dash_check.py judges the merge against every
# parent, as pre-push does. It judges a merge the user commits too, so
# pre-commit leaves every merge to it; any other commit already passed
# pre-commit's dash gate, so without MERGE_HEAD the hook only judges the lanes again
# (TODO-08 section 49), as it also does for a merge. `--no-verify` skips it, as it skips pre-commit; each gate names its
# own opt-out.
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=.githooks/lib/dash-gate.sh
. "$REPO_ROOT/.githooks/lib/dash-gate.sh"
# The merge check is bounded (dash_merge_head): storage that stalls it refuses the commit.
rc=0
MERGE_PARENTS="$(dash_merge_head)" || rc=$?
if [ "$rc" -eq 1 ]; then
    # Not a merge: judge the lanes again (TODO-08 section 49). pre-commit judged them before
    # the message editor opened, and a lane that started since then holds its paths now.
    exec python3 "$REPO_ROOT/scripts/lanes.py" check-staged
fi
if [ "$rc" -ne 0 ]; then
    echo -e "\033[31mcommit-msg: whether this is a merge could not be read (storage stalled or failed); commit again\033[0m"
    exit 1
fi
# A merge's lanes are judged again too: a lane that started while the message was written holds
# the paths this merge authors (lanes.py measures them against every parent).
python3 "$REPO_ROOT/scripts/lanes.py" check-staged || exit 1
# The parents the bounded probe read are handed over: the checker reads no file of its own for them.
mapfile -t PARENTS <<< "$MERGE_PARENTS"
dash_gate --merge-parents "${PARENTS[@]}"
