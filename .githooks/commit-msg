#!/usr/bin/env bash
# .githooks/commit-msg -- the ASCII-dash gate for a merge that git commits by
# itself (TODO-08 section 48). `git merge` runs pre-merge-commit, not
# pre-commit, and runs it before MERGE_HEAD exists, so that hook could judge
# the merge only against HEAD. commit-msg runs after MERGE_HEAD is written and
# before HEAD moves, so staged_dash_check.py judges the merge against every
# parent, as pre-push does. It judges a merge the user commits too, so
# pre-commit leaves every merge to it; any other commit already passed
# pre-commit, so the hook does nothing without MERGE_HEAD. `--no-verify` skips it, as it skips
# pre-commit; the gate names its own opt-out.
set -euo pipefail
MERGE_HEAD_FILE="$(git rev-parse --git-path MERGE_HEAD)"
[ -f "$MERGE_HEAD_FILE" ] || exit 0
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=.githooks/lib/dash-gate.sh
. "$REPO_ROOT/.githooks/lib/dash-gate.sh"
dash_gate --merge-head "$MERGE_HEAD_FILE"
