# Build artifacts
build/
iso/
*.o
*.bin
*.iso
*.img
*.elf
*.d

# Cross-compiler (built locally)
cross-compiler/

# Editor / IDE
.vscode/
*.swp
*.swo
*~

# Debug
serial.log
*.log

# OS-specific
.DS_Store
Thumbs.db
.build_number

# OVMF firmware copies
OVMF_VARS*.fd

# Icons8 color icons (licensed, not redistributable as standalone files)
resources/icons/color/**/*.png
!resources/icons/color/LICENSE.md

# Windows WSL zone identifiers
*:Zone.Identifier

# Secure Boot keys — private key must NEVER be committed
keys/MOK.key
*.signed.EFI

# Auto-generated build metadata header
include/build_info.h

# Bear compilation database (machine-specific absolute paths)
compile_commands.json

# clangd background index cache
.cache/

# Srclight code intelligence index
.srclight/

# SDK tool binaries (compiled on host, not tracked)
sdk/tools/*.exe
sdk/tools/*.o
