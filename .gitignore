# Build artifacts
build/
iso/
*.o
*.bin
*.iso
*.img
*.elf
*.d

# Cross-compiler (built locally)
cross-compiler/

# Editor / IDE
.vscode/
*.swp
*.swo
*~

# Debug
serial.log
*.log

# OS-specific
.DS_Store

# Python (host-side tooling under scripts/)
__pycache__/
*.pyc
Thumbs.db
.build_number

# OVMF firmware copies
OVMF_VARS*.fd

# Icons8 color icons (licensed, not redistributable as standalone files)
resources/icons/color/**/*.png
!resources/icons/color/LICENSE.md

# Windows WSL zone identifiers
*:Zone.Identifier

# Secure Boot keys — private key must NEVER be committed
keys/MOK.key
*.signed.EFI

# Auto-generated build metadata header
include/build_info.h

# Bear compilation database (machine-specific absolute paths)
compile_commands.json

# clangd background index cache
.cache/

# SDK tool binaries (compiled on host, not tracked)
sdk/tools/*
!sdk/tools/.gitkeep

# SDK downloaded build tools
sdk/build/

# Extracted debug logs
/debug/

# Claude Code user-local harness overrides (personal permissions, scratch rules).
# Shared repo policy lives in .claude/settings.json; per-user overrides go in
# .claude/settings.local.json (never committed). See
# docs/infrastructure/ai-system.md "MCP, Permissions, and Extension Boundary".
.claude/settings.local.json

# .claude/state/ -- runtime state files for hooks (last-codex-review.json etc).
# Keep .keep + README.md tracked; everything else is per-session/runtime.
.claude/state/*
!.claude/state/.keep
!.claude/state/README.md
